<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#3300E5FF" />
            <stroke android:width="1.5dp" android:color="#00E5FF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#4D38BDF8" />
            <stroke android:width="1dp" android:color="#38BDF8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#0DFFFFFF" />
            <stroke android:width="0.8dp" android:color="#1AFFFFFF" />
        </shape>
    </item>
</selector>
