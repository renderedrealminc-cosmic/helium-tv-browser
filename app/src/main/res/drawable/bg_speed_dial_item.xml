<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#4500E5FF"
                android:startColor="#301A237E" />
            <stroke android:width="3dp" android:color="@color/liquid_cyan" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#18FFFFFF"
                android:startColor="#0DFFFFFF" />
            <stroke android:width="1dp" android:color="@color/glass_border" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
