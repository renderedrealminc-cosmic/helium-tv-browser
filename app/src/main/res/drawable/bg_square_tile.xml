<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#F222324C" />
            <stroke android:width="2.5dp" android:color="#00E5FF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#FF101826" />
            <stroke android:width="1.5dp" android:color="#8038BDF8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#E6151E2E" />
            <stroke android:width="1.5dp" android:color="#4D38BDF8" />
        </shape>
    </item>
</selector>
