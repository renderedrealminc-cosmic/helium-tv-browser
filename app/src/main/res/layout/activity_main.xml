<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115">

    <!-- Mozilla GeckoView Engine Surface -->
    <org.mozilla.geckoview.GeckoView
        android:id="@+id/geckoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- TV Speed Dial Home Screen Overlay -->
    <LinearLayout
        android:id="@+id/speedDialContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60D1117"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎈 Helium TV Browser"
            android:textColor="#58A6FF"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Rust + Kotlin Native Core • WebExtensions • AdBlock • Hybrid Mouse"
            android:textColor="#8B949E"
            android:textSize="16sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/speedDialRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="💡 TV Remote Shortcuts: [RED] Extensions • [GREEN] Mouse Cursor • [YELLOW] AdBlock • [BLUE] PiP • [MENU] Bar"
            android:textColor="#7EE787"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Hybrid Virtual Mouse Pointer Overlay -->
    <org.helium.tv.browser.input.VirtualMouseOverlay
        android:id="@+id/virtualMouseOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- TV Quick Bar / Navigation Toolbar -->
    <LinearLayout
        android:id="@+id/toolbarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#F0161B22"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/urlEditText"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="#21262D"
                android:hint="Search with DuckDuckGo or enter URL..."
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#8B949E"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnMouseToggle"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#238636"
                android:focusable="true"
                android:text="🖱️ Mouse: ON"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnAdblockStats"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#DA3633"
                android:focusable="true"
                android:text="🛡️ 0"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnExtensions"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#1F6FEB"
                android:focusable="true"
                android:text="🧩 Extensions"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnUserAgent"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#30363D"
                android:focusable="true"
                android:text="UA: TV"
                android:textColor="#C9D1D9"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnOpacity"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:backgroundTint="#30363D"
                android:focusable="true"
                android:text="Alpha: 100%"
                android:textColor="#C9D1D9"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:indeterminate="false"
            android:max="100"
            android:progressDrawable="@android:drawable/progress_horizontal"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
