<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Mozilla GeckoView Engine Surface (Renders Bing, Google, Websites) -->
    <org.mozilla.geckoview.GeckoView
        android:id="@+id/geckoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Top Navigation & Address Bar (Clean, Bold, Phone & TV Compatible) -->
    <LinearLayout
        android:id="@+id/browserTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Helium Logo -->
        <ImageView
            android:id="@+id/ivAppLogo"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Helium Logo"
            android:scaleType="centerCrop"
            android:src="@drawable/helium_logo" />

        <!-- Home Button (Loads Microsoft Bing) -->
        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Home"
            android:focusable="true"
            android:scaleType="centerInside"
            android:src="@drawable/ic_home" />

        <!-- Bold High-Contrast URL / Search Bar -->
        <LinearLayout
            android:id="@+id/urlBarContainer"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_pill"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <EditText
                android:id="@+id/etUrl"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Search Bing or type URL"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="#0F172A"
                android:textColorHint="#64748B"
                android:textCursorDrawable="@null"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Reload Button -->
        <ImageButton
            android:id="@+id/btnReload"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Reload"
            android:focusable="true"
            android:scaleType="centerInside"
            android:src="@drawable/ic_refresh" />

        <!-- AdBlock Shield Button -->
        <FrameLayout
            android:id="@+id/btnShieldLayout"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_icon_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/btnShield"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Shield"
                android:scaleType="centerInside"
                android:src="@drawable/ic_shield" />

            <TextView
                android:id="@+id/tvShieldCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:background="#EA4335"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 3-Dots Menu Button -->
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Menu"
            android:focusable="true"
            android:scaleType="centerInside"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

    <!-- Page Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:layout_marginTop="56dp"
        android:elevation="6dp"
        android:indeterminate="false"
        android:max="100"
        android:progressDrawable="@android:drawable/progress_horizontal"
        android:visibility="gone" />

    <!-- Bottom Clean Bold Shortcut Dock (Phone & TV Compatible) -->
    <HorizontalScrollView
        android:id="@+id/bottomShortcutBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipToPadding="false"
        android:elevation="6dp"
        android:overScrollMode="never"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuickBing"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_quick_shortcut"
                android:elevation="2dp"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="🌐 Bing"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnQuickGoogle"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_quick_shortcut"
                android:elevation="2dp"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="🔍 Google"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnQuickYoutube"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_quick_shortcut"
                android:elevation="2dp"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="▶️ YouTube"
                android:textColor="#DC2626"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnQuickGemini"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_quick_shortcut"
                android:elevation="2dp"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="✨ Gemini AI"
                android:textColor="#2563EB"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnQuickExtensions"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_quick_shortcut"
                android:elevation="2dp"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="🧩 Add-ons"
                android:textColor="#7C3AED"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Slide-in Gemini AI Assistant Panel -->
    <LinearLayout
        android:id="@+id/geminiPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#FFFFFF"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_gemini_sparkle" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Gemini AI Assistant"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCloseGemini"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_quick_shortcut"
                android:text="✕ Close"
                android:textColor="#0F172A"
                android:textSize="12sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etGeminiPrompt"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_search_pill"
            android:hint="Ask Gemini anything or summarize page..."
            android:imeOptions="actionSend"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#0F172A"
            android:textColorHint="#64748B"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuickSummarize"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_quick_shortcut"
                android:text="📄 Summarize"
                android:textColor="#2563EB"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnQuickHindi"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_quick_shortcut"
                android:text="🌐 Hindi Me"
                android:textColor="#7C3AED"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tvGeminiResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="✨ Gemini AI ready! Ask any question or click Summarize above."
                android:textColor="#1E293B"
                android:textSize="14sp" />
        </ScrollView>
    </LinearLayout>

    <!-- Hybrid Neon Ring Virtual Mouse Pointer Overlay (TV mode only) -->
    <org.helium.tv.browser.input.VirtualMouseOverlay
        android:id="@+id/virtualMouseOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
