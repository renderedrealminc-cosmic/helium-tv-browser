<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_liquid_wallpaper">

    <!-- Native Chromium-powered WebView (Fast, Memory-safe, Modern Web) -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="54dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone" />

    <!-- Top Chromium Omnibox Bar (Edge / Chromium Style from Screenshot) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_gravity="top"
        android:background="#F2EAF4"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Navigation Buttons -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Back"
            android:focusable="true"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back" />

        <ImageButton
            android:id="@+id/btnForward"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Forward"
            android:focusable="true"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_forward" />

        <ImageButton
            android:id="@+id/btnReload"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Reload"
            android:focusable="true"
            android:scaleType="centerInside"
            android:src="@drawable/ic_refresh" />

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Home"
            android:focusable="true"
            android:scaleType="centerInside"
            android:src="@drawable/ic_home" />

        <!-- Stadium Omnibox / Address Bar -->
        <LinearLayout
            android:id="@+id/omniboxContainer"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_pill"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Search Icon"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/etOmnibox"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Enter search or web address"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="#0F172A"
                android:textColorHint="#64748B"
                android:textCursorDrawable="@null"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Adblock Shield Button -->
        <FrameLayout
            android:id="@+id/btnShieldLayout"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_icon_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/btnShield"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Shield"
                android:scaleType="centerInside"
                android:src="@drawable/ic_shield" />

            <TextView
                android:id="@+id/tvShieldCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:background="#EA4335"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 3-Dots Menu Button -->
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Menu"
            android:focusable="true"
            android:scaleType="centerInside"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

    <!-- Page Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:layout_gravity="top"
        android:layout_marginTop="54dp"
        android:elevation="6dp"
        android:indeterminate="false"
        android:max="100"
        android:progressDrawable="@android:drawable/progress_horizontal"
        android:visibility="gone" />

    <!-- Modern Pastel / Liquid Bubble Home Screen (Matches Uploaded Screenshot) -->
    <FrameLayout
        android:id="@+id/homeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="54dp"
        android:background="@drawable/bg_liquid_wallpaper">

        <!-- Center Glowing Logo / Liquid Orb Aesthetic -->
        <ImageView
            android:id="@+id/ivCenterLiquidOrb"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:alpha="0.85"
            android:contentDescription="Liquid Orb"
            android:scaleType="centerCrop"
            android:src="@drawable/helium_logo" />

        <!-- Main Home Vertical Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <!-- Center Prominent Search Stadium Pill -->
            <LinearLayout
                android:id="@+id/centerSearchContainer"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:maxWidth="520dp"
                android:background="@drawable/bg_center_search"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:id="@+id/ivCenterSearchLogo"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Search Provider"
                    android:src="@drawable/ic_google_g" />

                <EditText
                    android:id="@+id/etCenterSearch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="Search the web"
                    android:imeOptions="actionSearch"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:textColor="#0F172A"
                    android:textColorHint="#64748B"
                    android:textCursorDrawable="@null"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Quick Speed Dial Circular Icons (Matches Screenshot) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Bing Shortcut -->
                <ImageButton
                    android:id="@+id/btnShortcutBing"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_circle_button"
                    android:contentDescription="Bing"
                    android:elevation="3dp"
                    android:focusable="true"
                    android:scaleType="centerInside"
                    android:src="@drawable/helium_logo" />

                <!-- Google Shortcut -->
                <ImageButton
                    android:id="@+id/btnShortcutGoogle"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_circle_button"
                    android:contentDescription="Google"
                    android:elevation="3dp"
                    android:focusable="true"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_google_g" />

                <!-- YouTube Shortcut -->
                <ImageButton
                    android:id="@+id/btnShortcutYoutube"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_circle_button"
                    android:contentDescription="YouTube"
                    android:elevation="3dp"
                    android:focusable="true"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_youtube" />

                <!-- Gemini AI Shortcut -->
                <ImageButton
                    android:id="@+id/btnShortcutGemini"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_circle_button"
                    android:contentDescription="Gemini AI"
                    android:elevation="3dp"
                    android:focusable="true"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_gemini_sparkle" />
            </LinearLayout>

        </LinearLayout>

        <!-- Bottom Inspirational Quote (Exact quote from screenshot) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:text="You can't stop the waves, but you can learn to surf"
            android:textColor="#594E6A"
            android:textSize="13sp"
            android:textStyle="italic|bold" />
    </FrameLayout>

    <!-- Clean Error & Retry Screen (No More Crashes!) -->
    <LinearLayout
        android:id="@+id/errorContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="54dp"
        android:background="#F2EAF4"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="460dp"
            android:background="@drawable/bg_glass_card"
            android:elevation="6dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️"
                android:textSize="42sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Webpage Failed to Load"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Check your internet connection and try again."
                android:textColor="#64748B"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_quick_shortcut"
                    android:focusable="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="🔄 Retry"
                    android:textColor="#2563EB"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnErrorHome"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_quick_shortcut"
                    android:focusable="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="🏠 Bing Home"
                    android:textColor="#0F172A"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Slide-in Gemini AI Assistant Panel -->
    <LinearLayout
        android:id="@+id/geminiPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:maxWidth="440dp"
        android:background="#FFFFFF"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_gemini_sparkle" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Gemini AI Assistant"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCloseGemini"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_quick_shortcut"
                android:text="✕ Close"
                android:textColor="#0F172A"
                android:textSize="12sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etGeminiPrompt"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_search_pill"
            android:hint="Ask Gemini anything or summarize page..."
            android:imeOptions="actionSend"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#0F172A"
            android:textColorHint="#64748B"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuickSummarize"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_quick_shortcut"
                android:text="📄 Summarize"
                android:textColor="#2563EB"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnQuickHindi"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_quick_shortcut"
                android:text="🌐 Hindi Me"
                android:textColor="#7C3AED"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tvGeminiResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="✨ Gemini AI ready! Ask any question or click Summarize above."
                android:textColor="#1E293B"
                android:textSize="14sp" />
        </ScrollView>
    </LinearLayout>

    <!-- Hybrid Virtual Mouse Pointer Overlay (TV mode only) -->
    <org.helium.tv.browser.input.VirtualMouseOverlay
        android:id="@+id/virtualMouseOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
