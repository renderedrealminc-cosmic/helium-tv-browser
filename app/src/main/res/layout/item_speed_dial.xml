<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="105dp"
    android:layout_height="115dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Circular Favicon / Icon Container -->
    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_horizontal">

        <ImageView
            android:id="@+id/ivBookmarkIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Bookmark Icon"
            android:scaleType="centerInside" />

        <TextView
            android:id="@+id/tvBookmarkLetter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Pin + URL/Title Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivPin"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="Pinned"
            android:src="@drawable/ic_pin" />

        <TextView
            android:id="@+id/tvBookmarkTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="https://w..."
            android:textColor="#3C4043"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
